{
  "expo": {
    "name": "png-events-tickets",
    "slug": "png-events-tickets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pngeventstickets",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "package": "com.pngevents.tickets",
      "adaptiveIcon": {
        "backgroundColor": "#64152D",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cf5c9a7-d608-4a1a-9325-00c31beb44b3"
      }
    },
    "owner": "24704330jama"
  }
}
